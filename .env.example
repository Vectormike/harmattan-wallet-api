NODE_ENV=development
PORT=3000
APP_PORT=3000
POSTGRES_PORT=5433
POSTGRES_DB=harmattan
POSTGRES_USER=harmattan
POSTGRES_PASSWORD=harmattan_local
DATABASE_URL=postgresql://harmattan:harmattan_local@localhost:5433/harmattan?schema=public

FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
FX_PROVIDER_ATTRIBUTION_URL=https://www.exchangerate-api.com
FX_REQUEST_TIMEOUT_MS=3000
FX_REFRESH_WAIT_TIMEOUT_MS=5000
FX_FIXED_VERSION=fixed-v1
FX_FIXED_NGN_PER_USD=1600
FX_FIXED_GHS_PER_USD=15.5
FX_FIXED_XAF_PER_USD=610
FX_FIXED_EUR_PER_USD=0.92

SWAP_QUOTE_TTL_SECONDS=60
SWAP_MAX_RATE_DEVIATION_BPS=50
SWAP_MAX_SOURCE_AMOUNT_CNGN=10000000
SWAP_MAX_SOURCE_AMOUNT_CGHS=100000
SWAP_MAX_SOURCE_AMOUNT_CXAF=10000000
SWAP_MAX_SOURCE_AMOUNT_USDX=10000
SWAP_MAX_SOURCE_AMOUNT_EURX=10000

DEPOSIT_AMOUNT_WINDOW_SECONDS=60
DEPOSIT_SOFT_THROTTLE_ENABLED=false
TRANSFER_VELOCITY_WINDOW_SECONDS=60
TRANSFER_DISTINCT_RECIPIENT_THRESHOLD=5
TRANSFER_SOFT_THROTTLE_ENABLED=false
